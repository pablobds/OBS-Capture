#!/data/data/com.termux/files/usr/bin/bash

export DISPLAY=":1"
STREAM_URL="udp://127.0.0.1:9999?pkt_size=1316"
VIEW_URL="udp://@127.0.0.1:9999"

# =========================================================
# AUTO-LIMPEZA: Mata instâncias antigas presas
# =========================================================
pkill -9 ffmpeg 2>/dev/null
sleep 0.3

# Cores ANSI
CYAN='\033[1;36m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
RED='\033[1;31m'
PURPLE='\033[1;35m'
WHITE='\033[1;37m'
GRAY='\033[0;90m'
NC='\033[0m'

# Garante que ao pressionar Ctrl+C tudo feche de verdade
trap 'pkill -9 ffmpeg 2>/dev/null; printf "\n\n${RED}>> Transmissao finalizada.${NC}\n"; exit 0' INT TERM

# =========================================================
# BANNER E LOADER
# =========================================================
banner() {
    clear
    printf "${CYAN}"
    cat << "EOF"
  ___  ____  ____        ____    _    ____ _____ _   _ ____  _____ 
 / _ \| __ )/ ___|      / ___|  / \  |  _ \_   _| | | |  _ \| ____|
| | | |  _ \\___ \ ____| |     / _ \ | |_) || | | | | | |_) |  _|  
| |_| | |_) |___) |____| |___ / ___ \|  __/ | | | |_| |  _ <| |___ 
 \___/|____/|____/      \____/_/   \_\_|    |_|  \___/|_| \_\_____|
EOF
    printf "${PURPLE}           [ 60 FPS • LOW OVERHEAD ARM ]${NC}\n"
    printf "${GRAY}------------------------------------------------------------${NC}\n"
}

loader() {
    msg="$1"
    printf "\n${CYAN}>> ${WHITE}%s ${YELLOW}" "$msg"
    for cycle in 1 2; do
        for frame in "|" "/" "-" "\\"; do
            printf "%s" "$frame"
            sleep 0.08
            printf "\b"
        done
    done
    printf "${GREEN}[OK]${NC}\n\n"
    sleep 0.3
}

exibir_info_stream() {
    modo="$1"
    resolucao="$2"

    printf "${CYAN}+----------------------------------------------------------+${NC}\n"
    printf "${CYAN}|${WHITE}            TRANSMISSAO ATIVA - OBS-CAPTURE 60 FPS        ${CYAN}|${NC}\n"
    printf "${CYAN}+----------------------------------------------------------+${NC}\n"
    printf "${CYAN}|${NC} %-12s: ${WHITE}%-40s${CYAN}|${NC}\n" "Modo" "$modo"
    printf "${CYAN}|${NC} %-12s: ${WHITE}%-40s${CYAN}|${NC}\n" "Resolucao" "$resolucao"
    printf "${CYAN}+----------------------------------------------------------+${NC}\n"
    printf "${CYAN}|${PURPLE} URL DO STREAM (ABRA NO VLC / MPV):                        ${CYAN}|${NC}\n"
    printf "${CYAN}|${NC} ${GREEN}%-56s${NC} ${CYAN}|${NC}\n" "$VIEW_URL"
    printf "${CYAN}+----------------------------------------------------------+${NC}\n"
    printf "${CYAN}|${GRAY} Comando para testar: mpv %-32s${CYAN}|${NC}\n" "$VIEW_URL"
    printf "${CYAN}+----------------------------------------------------------+${NC}\n"
    printf "${YELLOW}>> Pressione [Ctrl + C] para encerrar.${NC}\n\n"
}

# =========================================================
# VALIDAÇÕES
# =========================================================
if [ "$(id -u)" -eq 0 ]; then
    printf "${RED}ERRO: Nao execute como root (sem sudo)!${NC}\n"
    exit 1
fi

banner
printf "${WHITE}Escolha o modo de captura:${NC}\n"
printf "  ${CYAN}[1]${NC} Tela Cheia (60 FPS)\n"
printf "  ${CYAN}[2]${NC} Janela Especifica com Auto-Reload (60 FPS)\n"
printf "${GRAY}------------------------------------------------------------${NC}\n"
printf "${YELLOW}Opcao (1 ou 2): ${NC}"
read -r OPCAO

X264_TURBO="no-deblock=1:scenecut=0:rc-lookahead=0:sync-lookahead=0:ref=1:bframes=0:subme=0:me=dia:weightp=0:aq-mode=0"

# =========================================================
# MODO 1: TELA INTEIRA
# =========================================================
if [ "$OPCAO" = "1" ]; then
    loader "Ajustando proporcoes da tela"

    GEOM=$(xwininfo -root -display "$DISPLAY" 2>/dev/null | grep -m1 'geometry' | awk '{print $2}' | cut -d'+' -f1)
    RAW_W=$(echo "$GEOM" | cut -d'x' -f1)
    RAW_H=$(echo "$GEOM" | cut -d'x' -f2)

    SW=$(( (RAW_W / 2) * 2 ))
    SH=$(( (RAW_H / 2) * 2 ))

    loader "Iniciando FFmpeg 60 FPS"
    clear
    exibir_info_stream "Tela Cheia" "${SW}x${SH}"

    ffmpeg -hide_banner -loglevel warning \
      -f x11grab -draw_mouse 0 -framerate 60 -video_size "${SW}x${SH}" -i "${DISPLAY}.0" \
      -c:v libx264 -preset ultrafast -tune zerolatency -profile:v baseline \
      -x264-params "$X264_TURBO" \
      -pix_fmt yuv420p -crf 30 -g 60 -threads 4 \
      -fflags nobuffer+flush_packets -flags low_delay \
      -probesize 32 -analyzeduration 0 \
      -f mpegts "$STREAM_URL"
    exit 0

# =========================================================
# MODO 2: JANELA ESPECÍFICA (AUTO-RELOAD)
# =========================================================
elif [ "$OPCAO" = "2" ]; then
    printf "\n"
    printf "${YELLOW}+----------------------------------------------------------+${NC}\n"
    printf "${YELLOW}|   >> VA AO VNC/XFCE E TOQUE NA JANELA DESEJADA <<        |${NC}\n"
    printf "${YELLOW}+----------------------------------------------------------+${NC}\n"

    INFO=$(xwininfo -display "$DISPLAY" 2>/dev/null)
    WINDOW_ID=$(echo "$INFO" | grep -m1 'xwininfo: Window id:' | awk '{print $4}')

    if [ -z "$WINDOW_ID" ]; then
        printf "${RED}ERRO: Nenhuma janela foi selecionada.${NC}\n"
        exit 1
    fi

    WIN_NAME=$(echo "$INFO" | grep -m1 'xwininfo: Window id:' | cut -d'"' -f2)

    loader "Conectando na janela: $WIN_NAME"

    while true; do
        if ! xwininfo -id "$WINDOW_ID" -display "$DISPLAY" >/dev/null 2>&1; then
            printf "\n${RED}>> A janela '%s' foi fechada. Encerrando.${NC}\n" "$WIN_NAME"
            exit 0
        fi

        CUR_INFO=$(xwininfo -id "$WINDOW_ID" -display "$DISPLAY" 2>/dev/null)
        RAW_W=$(echo "$CUR_INFO" | grep -m1 'Width:' | awk '{print $2}')
        RAW_H=$(echo "$CUR_INFO" | grep -m1 'Height:' | awk '{print $2}')

        CUR_W=$(( (RAW_W / 2) * 2 ))
        CUR_H=$(( (RAW_H / 2) * 2 ))

        clear
        exibir_info_stream "Janela: $WIN_NAME" "${CUR_W}x${CUR_H}"

        ffmpeg -hide_banner -loglevel warning \
          -f x11grab -draw_mouse 0 -framerate 60 -video_size "${CUR_W}x${CUR_H}" -window_id "$WINDOW_ID" -i "${DISPLAY}.0" \
          -c:v libx264 -preset ultrafast -tune zerolatency -profile:v baseline \
          -x264-params "$X264_TURBO" \
          -pix_fmt yuv420p -crf 30 -g 60 -threads 4 \
          -fflags nobuffer+flush_packets -flags low_delay \
          -probesize 32 -analyzeduration 0 \
          -f mpegts "$STREAM_URL"

        # Ao redimensionar, mata o FFmpeg anterior antes de abrir o próximo
        pkill -9 ffmpeg 2>/dev/null
        sleep 0.5

        printf "\n${YELLOW}>> Redimensionamento detectado! Recalibrando...${NC}\n"
    done

else
    printf "${RED}Opcao invalida!${NC}\n"
    exit 1
fi
